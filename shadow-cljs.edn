{:deps {:aliases [:test :secure-test :konserve :mixed-test :cljs]}

 :dependencies []

 :builds
 {:node-test
  {:target :node-test
   :output-to "target/node-tests.js"
   ;; Only .cljc tests reach this build; the JVM-only integration tests are
   ;; .clj and are invisible here by construction.
   :ns-regexp "-test$"}
  :mixed-content
  {:target :node-script
   :main netz.mixed-content-client/main
   :output-to "target/mixed-content-client.js"}
  :mixed-sync
  {:target :node-script
   :main netz.mixed-sync-client/main
   :output-to "target/mixed-sync-client.js"}}}
