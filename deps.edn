{:paths ["src"]

 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        ;; kabel supplies the transport (peers, WebSocket, codec middleware)
        ;; and the pub/sub layer netz plugs a transport into. 0.3.124 exposes
        ;; the peer/topic apply serializer, selected-connection unsubscribe,
        ;; exclusive inbound live ownership, exact decoded frame-size metadata,
        ;; and bounded 5 MiB WebSocket frames/queues. Jetty provides
        ;; completion-driven server writes and the bounded replikativ http-kit
        ;; adapter. Everything netz needs from kabel is public API.
        org.replikativ/kabel {:mvn/version "0.3.124"}
        ;; Ed25519, SHA-256, constant-time compare, CSPRNG — portable across
        ;; JVM and ClojureScript. Unlike kabel, netz cannot make crypto
        ;; optional: self-certifying identity is the bottom of the design.
        org.replikativ/geheimnis {:mvn/version "0.2.38"}
        org.replikativ/superv.async {:mvn/version "0.3.50"}
        org.replikativ/hasch {:mvn/version "0.4.100"}
        ;; RFC 8949 deterministic CBOR for the language-neutral wire profile.
        ;; Declared directly because signatures/test vectors must not change
        ;; when kabel changes its own serialization dependency graph.
        org.replikativ/boring {:mvn/version "0.1.27"}
        org.replikativ/logging {:mvn/version "0.1.3"}}

 :aliases
 ;; `netz.sim` lives on the TEST path, not in src/. It is a harness for driving
 ;; the pure state machines deterministically, and a consumer of the library
 ;; should not carry it. `netz.sim.rng` stays in src/ -- the machines take an
 ;; `:rng` and must be reproducible, so that one is production code.
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      org.clojure/test.check {:mvn/version "1.1.1"}}
         :exec-fn cognitect.test-runner.api/test}

  ;; Integration gate for the not-yet-released secure-transport stack. Keep
  ;; these Git overrides out of the runtime graph: consumers continue to
  ;; resolve the last released Kabel/Geheimnis coordinates while this checkout
  ;; tests Kabel's merged transport-context/Python-carrier commit and the
  ;; reviewed Geheimnis Noise commit exactly.
  :secure-test
  {:extra-paths ["test" "test-secure"]
   :override-deps
    {org.replikativ/kabel
    {:git/url "https://github.com/replikativ/kabel.git"
     :git/sha "4da3e07c72223566ee203ac519dd22014cfe2f62"}
    org.replikativ/geheimnis
    {:git/url "https://github.com/replikativ/geheimnis.git"
     :git/sha "ed95baf100456ea09c3d6ae4dd089049363785d2"}}
   :extra-deps
   {io.github.cognitect-labs/test-runner
    {:git/tag "v0.5.1" :git/sha "dfb30dd"}
    org.clojure/data.json {:mvn/version "2.5.1"}
    org.clojure/test.check {:mvn/version "1.1.1"}}
   :exec-fn cognitect.test-runner.api/test}

  ;; The konserve-backed PPeerStore (netz.store.konserve). konserve is the
  ;; consumer's to provide, exactly as kabel keeps storage optional, so the
  ;; test lives on its own path and the default suite never loads it.
  ;;   clojure -X:konserve:test :dirs '["test" "test-konserve"]'
  :konserve {:extra-paths ["test-konserve"]
             :extra-deps {org.replikativ/konserve {:mvn/version "0.9.375"}}}

  ;; Optional workspace-level compatibility gate. These local roots are kept
  ;; out of the library's runtime/POM and are only resolved when maintainers
  ;; explicitly run:
  ;;   clojure -X:stack :dirs '["test-stack"]'
  ;; It proves the real integration seams against sibling checkouts while the
  ;; ordinary release remains installable without the whole stack present.
  :stack {:extra-paths ["test" "test-stack"]
          :extra-deps {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                       org.replikativ/urd {:local/root "../urd"}
                       org.replikativ/datahike {:local/root "../datahike"}
                       org.replikativ/yggdrasil {:local/root "../yggdrasil"}
                       org.replikativ/spindel {:local/root "../spindel"}}
          :exec-fn cognitect.test-runner.api/test}

  :cljs {:extra-deps {thheller/shadow-cljs {:mvn/version "3.4.11"}
                      org.clojure/clojurescript {:mvn/version "1.12.145"}}}

  :format {:extra-deps {cljfmt/cljfmt {:mvn/version "0.9.2"}}
           :main-opts ["-m" "cljfmt.main" "check"]}
  :ffix {:extra-deps {cljfmt/cljfmt {:mvn/version "0.9.2"}}
         :main-opts ["-m" "cljfmt.main" "fix"]}

  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.6"}
                 slipset/deps-deploy {:mvn/version "0.2.2"}}
          :ns-default build}}}
